{
  "schema_version": 1,
  "id": "two_step_cycle",
  "name": "Exact two-step cycle",
  "description": "Preserves the read symbol. A moves right to B; B moves left to A. The complete initial configuration repeats.",
  "semantics": "binary-two-way-write-move-halt-v1",
  "states": [
    "A",
    "B"
  ],
  "symbols": [
    0,
    1
  ],
  "blank_symbol": 0,
  "halt_state": "H",
  "initial": {
    "state": "A",
    "head": 0,
    "nonzero_cells": []
  },
  "transitions": {
    "A": {
      "0": {
        "write": 0,
        "move": "R",
        "next": "B"
      },
      "1": {
        "write": 1,
        "move": "R",
        "next": "B"
      }
    },
    "B": {
      "0": {
        "write": 0,
        "move": "L",
        "next": "A"
      },
      "1": {
        "write": 1,
        "move": "L",
        "next": "A"
      }
    }
  }
}
